# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Neon Postgres connection string (Vercel Marketplace > Neon sets this automatically)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Brevo (https://www.brevo.com) sends all site emails and manages the news and updates list.
# Without a key, emails are printed to the server log in development.
BREVO_API_KEY=
# Approved members who opt in on the Join form are added to this list
BREVO_JOIN_LIST_ID=
# Optional: gets an email whenever someone submits the Join form
ADMIN_NOTIFY_EMAIL=

# Admin dashboard at /admin
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters (e.g. `openssl rand -base64 32`)
ADMIN_SESSION_SECRET=

# WhatsApp invite links, loaded into the database with `npm run db:seed-links`.
# Never commit real links. They can also be edited later at /admin/settings.
WHATSAPP_LINK_MAIN_COMMUNITY=
WHATSAPP_LINK_PODCAST_MONTHLY=
WHATSAPP_LINK_PUBLIC_SCHOOL_LEADERS=
WHATSAPP_LINK_PRIVATE_SCHOOL_LEADERS=
WHATSAPP_LINK_SUPERINTENDENTS=
WHATSAPP_LINK_CURRICULUM_LEADERS=
WHATSAPP_LINK_TEACHERS=
WHATSAPP_LINK_TUTORING_OWNERS=
WHATSAPP_LINK_PARTNERS=

# Public URL used in emails, sitemap, and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://yourdomain.org
